<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2C23"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/poker_table" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_pos_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Opponent"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/opp1stack_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="100"
                    android:textColor="#F5E9C9" />

                <TextView
                    android:id="@+id/action_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="ACTION"
                    android:textColor="#F5E9C9" />

                <ProgressBar
                    android:id="@+id/opprogressbar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="100dp"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#D8B45A" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/oppcard1_image"
                    android:layout_width="44dp"
                    android:layout_height="62dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Opponent card"
                    android:src="@drawable/back" />

                <ImageView
                    android:id="@+id/oppcard2_image"
                    android:layout_width="44dp"
                    android:layout_height="62dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Opponent card"
                    android:src="@drawable/back" />
            </LinearLayout>

            <TextView
                android:id="@+id/GameInfo_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="POKER"
                android:textColor="#F5E9C9"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/flop1_imageview"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Community card"
                    android:src="@drawable/back" />

                <ImageView
                    android:id="@+id/flop2_imageview"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Community card"
                    android:src="@drawable/back" />

                <ImageView
                    android:id="@+id/flop3_imageview"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Community card"
                    android:src="@drawable/back" />

                <ImageView
                    android:id="@+id/turn_imageview"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Community card"
                    android:src="@drawable/back" />

                <ImageView
                    android:id="@+id/river_imageview"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Community card"
                    android:src="@drawable/back" />
            </LinearLayout>

            <TextView
                android:id="@+id/pot_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="POT: 0"
                android:textColor="#F5E9C9"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/HandWinner_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HAND WINNER"
                android:textColor="#F5E9C9"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/myprogressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="8dp"
                android:max="100"
                android:progress="100"
                android:progressTint="#D8B45A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_pos_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="You"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stack_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="100"
                    android:textColor="#F5E9C9" />

                <TextView
                    android:id="@+id/action_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="ACTION"
                    android:textColor="#F5E9C9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mycard1_image"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Your card"
                    android:src="@drawable/back" />

                <ImageView
                    android:id="@+id/mycard2_image"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_margin="3dp"
                    android:contentDescription="Your card"
                    android:src="@drawable/back" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bet_size_textview"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="#F5E9C9" />

        <SeekBar
            android:id="@+id/seekbar_bet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progressTint="#D8B45A"
            android:thumbTint="#F5E9C9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/newgame_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.2"
            android:text="NEW GAME"
            android:textSize="11sp" />

        <Button
            android:id="@+id/fold_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="FOLD"
            android:textSize="11sp" />

        <Button
            android:id="@+id/check_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CHECK"
            android:textSize="11sp" />

        <Button
            android:id="@+id/call_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CALL"
            android:textSize="11sp" />

        <Button
            android:id="@+id/betr_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="BET / RAISE"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
